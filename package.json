{
  "name": "my-turborepo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "db:up": "docker compose --env-file apps/api/.env up -d --wait",
    "db:down": "docker compose --env-file apps/api/.env down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pnpm": "12.4.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.8"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": "prettier --write --ignore-unknown"
  }
}
